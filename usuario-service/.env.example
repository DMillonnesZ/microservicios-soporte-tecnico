# Copia este archivo como ".env" (en esta misma carpeta) y completa tus datos.
# .env esta en .gitignore: NO se sube a GitHub.

# --- Correo (Gmail + Contrasena de aplicacion de 16 caracteres, sin espacios) ---
MAIL_USERNAME=tucuenta@gmail.com
MAIL_PASSWORD=abcdefghijklmnop
# true = envia correos reales | false = muestra el codigo en la consola
MAIL_ENABLED=false

# --- Base de datos (solo si tu root de MariaDB tiene clave) ---
DB_USERNAME=root
DB_PASSWORD=
